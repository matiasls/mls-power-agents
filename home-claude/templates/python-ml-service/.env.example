# Project
PROJECT_NAME=ml-service
ENV=local
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8001

# Database (if applicable)
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# Model storage
MODEL_REGISTRY_URI=./artifacts  # local path; in prod: s3://, mlflow://, etc.
MODEL_VERSION=latest

# External APIs (sandbox keys for local)
# NOSIS_API_KEY=

# Observability
# SENTRY_DSN=

# Feature flags
ENABLE_BATCH_PREDICTIONS=false
