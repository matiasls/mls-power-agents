# Project
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_ENV=development

# OAuth / Auth (if using)
# EXPO_PUBLIC_AUTH_DOMAIN=
# EXPO_PUBLIC_AUTH_CLIENT_ID=

# Analytics (optional)
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_AMPLITUDE_KEY=

# Push notifications (configure in EAS / Expo dashboard)
# Don't put push tokens in env

# EAS
# Configured in eas.json + Expo dashboard

# IMPORTANT: NEVER put secrets here. Anything in EXPO_PUBLIC_* is bundled into the app and visible to users.
# For secrets, use EAS secrets via `eas secret:create` or runtime fetch from your backend.
