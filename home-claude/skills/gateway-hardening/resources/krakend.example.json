{
  "$comment": "Reference KrakenD config — recommended for aggregating BFF. Declare EVERY endpoint explicitly (zero wildcards); replicate the endpoint block per route with its own rate limit and auth.",
  "version": 3,
  "name": "agroscore-gateway",
  "port": 8080,
  "timeout": "3s",
  "cache_ttl": "300s",
  "extra_config": {
    "router": {
      "return_error_msg": false,
      "disable_redirect_trailing_slash": true
    },
    "security/cors": {
      "allow_origins": ["https://app.tudominio.com"],
      "allow_methods": ["GET", "POST"],
      "allow_headers": ["Origin", "Authorization", "Content-Type"],
      "expose_headers": [],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/scores/{id}",
      "method": "GET",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 60,
          "client_max_rate": 60,
          "every": "1m"
        },
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "https://auth.tudominio.com/.well-known/jwks.json",
          "disable_jwk_security": false
        }
      },
      "backend": [
        {
          "url_pattern": "/scoring/{id}",
          "host": ["http://scoring-service:8080"]
        }
      ]
    }
  ]
}
